# ── hi-human configuration ──────────────────────────────────────
# Copy this file to `.env` and fill in your values:
#     cp .env.example .env
# `.env` is gitignored — never commit real keys.

# ── Devin API ───────────────────────────────────────────────────
# Service-user key from https://app.devin.ai (Settings → Service Users).
# Looks like:  cog_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEVIN_API_KEY=
# Override only if you use a non-default base (defaults to the v3 API).
DEVIN_API_BASE=https://api.devin.ai/v3
# Org for the v3 API. Auto-resolved from /v3/self if left blank.
DEVIN_ORG_ID=

# ── GitHub ──────────────────────────────────────────────────────
# Fine-grained PAT with Issues + Pull requests read/write on the fork.
GITHUB_TOKEN=
# owner/repo of your Superset fork.
GITHUB_REPO=kifune831-pixel/superset
# Base branch PRs target.
GITHUB_BASE_BRANCH=master
# Optional: set to verify incoming GitHub webhook signatures.
GITHUB_WEBHOOK_SECRET=

# ── Server ──────────────────────────────────────────────────────
PORT=3000
# How often the poller advances active Devin sessions (ms).
POLL_INTERVAL_MS=8000
